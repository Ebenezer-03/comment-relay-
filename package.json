{
  "name": "comment-relay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vitejs/plugin-react": "^6.0.5",
    "ai": "^6.0.247",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "googleapis": "^174.0.1",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "vite": "^8.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vercel/config": "^0.5.6",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "vitest": "^3.2.4",
    "ws": "^8.21.3"
  }
}
