GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8787/api/oauth2callback
PORT=8787
FRONTEND_URL=http://localhost:5173

# AES-256 key (base64) used to encrypt OAuth tokens at rest in the sessions
# table. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing/rotating this key invalidates every existing session.
SESSION_ENCRYPTION_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`
# when calling GET /api/internal/sync/tick. Required in production for the
# cron-driven sync to run; generate the same way as SESSION_ENCRYPTION_KEY.
CRON_SECRET=

# Daily YouTube Data API quota accounting (server/quota.js). All creators
# currently share one Google Cloud project's quota pool (10,000 units/day
# by default), so these caps keep one large channel from starving everyone
# else's sync. Defaults are conservative; raise DAILY_QUOTA_BUDGET only if
# you've requested a quota increase from Google.
DAILY_QUOTA_BUDGET=8000
PER_CREATOR_DAILY_QUOTA=1500
